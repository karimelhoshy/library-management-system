# ─────────────────────────────────────────────────────────────────────────────
# Shelfwise configuration. Copy to .env.local and fill in.
# Only DATABASE_URL and AUTH_SECRET are required; everything else is optional
# and the matching feature switches itself off when the value is empty.
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED · Postgres with the `vector` and `pg_trgm` extensions (Neon works out of the box).
# Local Docker: postgres://shelfwise:shelfwise@localhost:54329/shelfwise
DATABASE_URL=

# REQUIRED · Random secret for signing sessions. Generate with: openssl rand -base64 32
AUTH_SECRET=

# OPTIONAL · Google sign-in. Without these, the "Continue with Google" button is hidden.
# Authorized redirect URI: https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# OPTIONAL · Google Gemini (free tier works). Without it: no Ask the Librarian chat,
# no "Search by vibe", no shelf-photo import. Everything else works.
GEMINI_API_KEY=
# Optional overrides (defaults shown). GEMINI_MODEL takes one model or a fallback list.
# GEMINI_MODEL=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# How many AI requests the whole library may make per day (on top of per-user limits).
# AI_DAILY_BUDGET=300

# OPTIONAL · Email via Gmail SMTP (use an App Password, not your normal password).
# Without these, emails are still written to the in-app Outbox but not delivered.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# OPTIONAL · Protects /api/cron/reminders. Vercel Cron sends it automatically as a Bearer token.
# Without it, the cron endpoint refuses every request.
CRON_SECRET=

# OPTIONAL · "true" shows demo accounts, the role switcher, the demo banner and
# resets the data every night. Leave empty (false) for a real library.
DEMO_MODE=

# OPTIONAL · Rebrand the app.
NEXT_PUBLIC_APP_NAME=Shelfwise

# OPTIONAL · Public URL used in email links (defaults to the Vercel production URL).
# APP_URL=https://library.example.com
